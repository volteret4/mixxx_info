# Copia este fichero a .env y rellénalo. Todo es opcional.

# Servidor Subsonic (Airsonic, Navidrome…)
AIRSONIC_URL=
AIRSONIC_USER=
AIRSONIC_PASSWORD=
LASTFM_API_KEY=
DISCOGS_TOKEN=
GEMINI_API_KEY=
SEARXNG_URL=
SETTINGS_PASSWORD=

# ── docker-compose.yml ──────────────────────────────────────────
# Tu carpeta de canciones de Mixxx (obligatoria)
MIX=
# Uid:gid del usuario dueño de esta carpeta (los ficheros que se generan son suyos)
UID_GID=1000:1000
# Zona horaria de los trabajos programados (Ofelia)
TZ=Europe/Madrid
